# 🚀 Node.js / Next.js の標準 `.gitignore`

# 📂 Node Modules
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
.vscode/
.idea/

# ⚙️ Next.js ビルド & キャッシュ
.next/
out/
.cache/
.DS_Store

# 🌎 環境変数（必ず `.env` はGit管理から除外！）
.env
.env.local
.env.development.local
.env.test.local
.env.production.local

# 📜 TypeScript / ESLint / Jest / その他のキャッシュ
*.tsbuildinfo
.eslintcache
jest.config.js
coverage/

# 💾 Prisma / DB
prisma/dev.db
prisma/dev.db-journal
prisma/migrations/

# 📂 ログファイル
logs/
*.log
npm-debug.log*
yarn-debug.log*
pnpm-debug.log*
*.pid
*.seed

# 🛠️ Mac & Linux OS の不要ファイル
.DS_Store
Thumbs.db
